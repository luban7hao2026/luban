# Copy this file to .env and fill in real values before `docker compose up -d --build`.
# Do NOT commit the real .env.

# MySQL root password used by the mysql container AND the backend connection string.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-password

# HMAC secret for auth tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-auth-secret

# Browser-facing origin(s) allowed by FastAPI CORS. Comma-separated, no trailing slash.
# Frontend talks to the backend through the same-origin /api proxy, so this is mostly a
# safety net. For the target server use the public IP origin:
CORS_ORIGINS=http://121.40.198.70
